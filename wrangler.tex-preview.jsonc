{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qsseda-tex-gh-preview",
  "main": "studio/tex-github-preview.js",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "preview_urls": false,
  "minify": true,
  "keep_vars": false,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
