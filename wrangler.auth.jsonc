{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qsseda-auth",
  "main": "auth-entry.js",
  "compatibility_date": "2026-09-12",
  "workers_dev": false,
  "preview_urls": false,
  "minify": true,
  "keep_names": false,
  "upload_source_maps": false,
  "ratelimits": [
    {
      "name": "AUTH_LOGIN_RATE_LIMITER",
      "namespace_id": "730201",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "AUTH_OAUTH_RATE_LIMITER",
      "namespace_id": "730202",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  // Deployment touchpoint for Auth OAuth/PKCE and protected token introspection.
  "routes": [
    {
      "pattern": "auth.qsseda.studio",
      "custom_domain": true
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  }
}
