{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qsseda-auth",
  "main": "auth-entry.js",
  "compatibility_date": "2026-09-12",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "auth.qsseda.studio",
      "custom_domain": true
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  }
}
