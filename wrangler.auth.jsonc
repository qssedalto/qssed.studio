{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qsseda-auth",
  "main": "studio/auth-audit-entry.js",
  "compatibility_date": "2026-09-12",
  "workers_dev": false,
  "preview_urls": false,
  "minify": true,
  "keep_names": false,
  "upload_source_maps": false,
  "ratelimits": [
    {
      "name": "AUTH_LOGIN_RATE_LIMITER",
      "namespace_id": "730201",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "AUTH_OAUTH_RATE_LIMITER",
      "namespace_id": "730202",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "AUTH_EDGE_GLOBAL_RATE_LIMITER",
      "namespace_id": "730203",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "AUTH_EDGE_ANON_RATE_LIMITER",
      "namespace_id": "730204",
      "simple": {
        "limit": 90,
        "period": 60
      }
    },
    {
      "name": "AUTH_EDGE_SUSPECT_RATE_LIMITER",
      "namespace_id": "730205",
      "simple": {
        "limit": 15,
        "period": 60
      }
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "qsseda-studio-storage"
    }
  ],
  // Deployment touchpoint for Auth OAuth/PKCE and protected token introspection.
  "routes": [
    {
      "pattern": "auth.qsseda.com/*",
      "zone_name": "qsseda.com"
    },
    {
      "pattern": "auth.qsseda.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  }
}
