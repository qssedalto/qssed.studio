{
  // AERTEX Intelligence 部署清单：gpt.* 域与区域放置。migrations 记录历史 Durable Object 迁移，即使类已删除也不能随意抹掉迁移历史。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qsseda-gpt",
  "main": "gpt-worker.js",
  "compatibility_date": "2026-09-19",
  "workers_dev": false,
  "preview_urls": false,
  "minify": true,
  "keep_names": false,
  "upload_source_maps": false,
  "placement": {
    "region": "aws:us-east-1"
  },
  "routes": [
    { "pattern": "gpt.qsseda.com/*", "zone_name": "qsseda.com" },
    { "pattern": "gpt.qsseda.com", "custom_domain": true },
    { "pattern": "gpt.qsseda.online/*", "zone_name": "qsseda.online" },
    { "pattern": "gpt.qsseda.online", "custom_domain": true },
    { "pattern": "gpt.qsseda.studio/*", "zone_name": "qsseda.studio" },
    { "pattern": "gpt.qsseda.studio", "custom_domain": true }
  ],
  "migrations": [
    {
      "tag": "gpt-cloud-v1",
      "new_sqlite_classes": ["CodexCloudContainer"]
    },
    {
      "tag": "gpt-cloud-v2-remove-container",
      "deleted_classes": ["CodexCloudContainer"]
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  }
}
