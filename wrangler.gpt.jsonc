{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qsseda-gpt",
  "main": "gpt-worker.js",
  "compatibility_date": "2026-09-19",
  "workers_dev": false,
  "preview_urls": false,
  "minify": true,
  "keep_names": false,
  "upload_source_maps": false,
  "routes": [
    {
      "pattern": "gpt.qsseda.com/*",
      "zone_name": "qsseda.com"
    },
    {
      "pattern": "gpt.qsseda.com",
      "custom_domain": true
    }
  ],
  "migrations": [
    {
      "tag": "gpt-cloud-v1",
      "new_sqlite_classes": ["CodexCloudContainer"]
    },
    {
      "tag": "gpt-cloud-v2-remove-container",
      "deleted_classes": ["CodexCloudContainer"]
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  }
}
