{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qsseda-gpt",
  "main": "gpt-worker.js",
  "compatibility_date": "2026-09-19",
  "workers_dev": false,
  "preview_urls": false,
  "minify": true,
  "keep_names": false,
  "upload_source_maps": false,
  "routes": [
    {
      "pattern": "gpt.qsseda.studio",
      "custom_domain": true
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  }
}
