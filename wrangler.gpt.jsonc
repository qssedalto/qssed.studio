// 【初学者导读】
// 文件：wrangler.gpt.jsonc
// Cloudflare Wrangler 配置：声明 Worker 入口、兼容日期、环境绑定、R2/变量和部署名称，是生产路由/资源绑定的重要配置。
// 阅读顺序：先看 name/main/compatibility_date，再看 bindings、routes 和环境变量；这些字段决定 Worker 真正运行在哪、能访问什么资源。
// 修改注意：配置小改动可能改变生产 Worker 入口或资源绑定；应配合对应 CI 和部署日志核对。
// 初学者提示：配置文件同样是“代码的一部分”，它决定运行环境；出现“本地正常、线上异常”时要优先核对这里。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qsseda-gpt",
  "main": "gpt-worker.js",
  "compatibility_date": "2026-09-19",
  "workers_dev": false,
  "preview_urls": false,
  "minify": true,
  "keep_names": false,
  "upload_source_maps": false,
  "placement": {
    "region": "aws:us-east-1"
  },
  "routes": [
    { "pattern": "gpt.qsseda.com/*", "zone_name": "qsseda.com" },
    { "pattern": "gpt.qsseda.com", "custom_domain": true },
    { "pattern": "gpt.qsseda.online/*", "zone_name": "qsseda.online" },
    { "pattern": "gpt.qsseda.online", "custom_domain": true },
    { "pattern": "gpt.qsseda.studio/*", "zone_name": "qsseda.studio" },
    { "pattern": "gpt.qsseda.studio", "custom_domain": true }
  ],
  "migrations": [
    {
      "tag": "gpt-cloud-v1",
      "new_sqlite_classes": ["CodexCloudContainer"]
    },
    {
      "tag": "gpt-cloud-v2-remove-container",
      "deleted_classes": ["CodexCloudContainer"]
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  }
}
