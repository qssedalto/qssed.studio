{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qsseda-gpt",
  "main": "gpt-worker.js",
  "compatibility_date": "2026-09-19",
  "workers_dev": false,
  "preview_urls": false,
  "minify": true,
  "keep_names": false,
  "upload_source_maps": false,
  "routes": [
    {
      "pattern": "gpt.qsseda.studio",
      "custom_domain": true
    }
  ],
  "containers": [
    {
      "class_name": "CodexCloudContainer",
      "image": "./cloud-codex/Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GPT_CODEX",
        "class_name": "CodexCloudContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "gpt-cloud-v1",
      "new_sqlite_classes": ["CodexCloudContainer"]
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  }
}
