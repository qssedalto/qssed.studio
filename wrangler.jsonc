{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "restless-boat-f553",
  "main": "worker.js",
  "compatibility_date": "2026-05-25",
  "workers_dev": false,
  "preview_urls": false,
  "minify": true,
  "keep_names": false,
  "upload_source_maps": false,
  "keep_vars": true,
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "730101",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "API_READ_RATE_LIMITER",
      "namespace_id": "730102",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "API_WRITE_RATE_LIMITER",
      "namespace_id": "730103",
      "simple": {
        "limit": 90,
        "period": 60
      }
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "qsseda-studio-storage"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
