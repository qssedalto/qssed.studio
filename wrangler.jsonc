// 【初学者导读】
// 文件：wrangler.jsonc
// Cloudflare Wrangler 配置：声明 Worker 入口、兼容日期、环境绑定、R2/变量和部署名称，是生产路由/资源绑定的重要配置。
// 阅读顺序：先看 name/main/compatibility_date，再看 bindings、routes 和环境变量；这些字段决定 Worker 真正运行在哪、能访问什么资源。
// 修改注意：配置小改动可能改变生产 Worker 入口或资源绑定；应配合对应 CI 和部署日志核对。
// 初学者提示：配置文件同样是“代码的一部分”，它决定运行环境；出现“本地正常、线上异常”时要优先核对这里。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "restless-boat-f553",
  "main": "studio/worker-audit.js",
  "compatibility_date": "2026-05-25",
  "workers_dev": false,
  "preview_urls": false,
  "minify": true,
  "keep_names": false,
  "upload_source_maps": false,
  "keep_vars": true,
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "730101",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "API_READ_RATE_LIMITER",
      "namespace_id": "730102",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "API_WRITE_RATE_LIMITER",
      "namespace_id": "730103",
      "simple": {
        "limit": 90,
        "period": 60
      }
    },
    {
      "name": "EDGE_GLOBAL_RATE_LIMITER",
      "namespace_id": "730104",
      "simple": {
        "limit": 600,
        "period": 60
      }
    },
    {
      "name": "EDGE_ANON_RATE_LIMITER",
      "namespace_id": "730105",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "EDGE_SUSPECT_RATE_LIMITER",
      "namespace_id": "730106",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "EDGE_EXPENSIVE_RATE_LIMITER",
      "namespace_id": "730107",
      "simple": {
        "limit": 45,
        "period": 60
      }
    }
  ],
  "routes": [
    { "pattern": "qsseda.com/*", "zone_name": "qsseda.com" },
    { "pattern": "*.qsseda.com/*", "zone_name": "qsseda.com" },
    { "pattern": "qsseda.online/*", "zone_name": "qsseda.online" },
    { "pattern": "*.qsseda.online/*", "zone_name": "qsseda.online" },
    { "pattern": "qsseda.studio/*", "zone_name": "qsseda.studio" },
    { "pattern": "*.qsseda.studio/*", "zone_name": "qsseda.studio" }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "qsseda-studio-storage"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
