{
  // AERTEX 主站 Worker 部署清单：主域/通配子域、R2、全局 API/边缘限流以及定时审计任务。绑定名称必须和代码中的 env.* 一致。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "restless-boat-f553",
  "main": "studio/worker-audit.js",
  "compatibility_date": "2026-05-25",
  "workers_dev": false,
  "preview_urls": false,
  "minify": true,
  "keep_names": false,
  "upload_source_maps": false,
  "keep_vars": true,
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "730101",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "API_READ_RATE_LIMITER",
      "namespace_id": "730102",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "API_WRITE_RATE_LIMITER",
      "namespace_id": "730103",
      "simple": {
        "limit": 90,
        "period": 60
      }
    },
    {
      "name": "EDGE_GLOBAL_RATE_LIMITER",
      "namespace_id": "730104",
      "simple": {
        "limit": 600,
        "period": 60
      }
    },
    {
      "name": "EDGE_ANON_RATE_LIMITER",
      "namespace_id": "730105",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "EDGE_SUSPECT_RATE_LIMITER",
      "namespace_id": "730106",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "EDGE_EXPENSIVE_RATE_LIMITER",
      "namespace_id": "730107",
      "simple": {
        "limit": 45,
        "period": 60
      }
    }
  ],
  "routes": [
    { "pattern": "qsseda.com/*", "zone_name": "qsseda.com" },
    { "pattern": "*.qsseda.com/*", "zone_name": "qsseda.com" },
    { "pattern": "qsseda.online/*", "zone_name": "qsseda.online" },
    { "pattern": "*.qsseda.online/*", "zone_name": "qsseda.online" },
    { "pattern": "qsseda.studio/*", "zone_name": "qsseda.studio" },
    { "pattern": "*.qsseda.studio/*", "zone_name": "qsseda.studio" }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "qsseda-studio-storage"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
