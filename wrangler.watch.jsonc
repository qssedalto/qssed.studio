// AERTEX Watch: aw.* UI and awd.*/aw.data.* device endpoints are isolated by hostname in watch-worker.js.
// Legacy .studio serves data aliases only; the supported live roots are .com and .studio.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qsseda-watch",
  "main": "watch-worker.js",
  "compatibility_date": "2026-10-02",
  "workers_dev": false,
  "preview_urls": false,
  "minify": true,
  "keep_names": false,
  "upload_source_maps": false,
  "assets": {
    "directory": "./watch-web",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "qsseda-studio-storage"
    }
  ],
  "routes": [
    {
      "pattern": "aw.qsseda.com/*",
      "zone_name": "qsseda.com"
    },
    {
      "pattern": "aw.qsseda.com",
      "custom_domain": true
    },
    {
      "pattern": "awd.qsseda.com/*",
      "zone_name": "qsseda.com"
    },
    {
      "pattern": "awd.qsseda.com",
      "custom_domain": true
    },
    {
      "pattern": "aw.data.qsseda.com/*",
      "zone_name": "qsseda.com"
    },
    {
      "pattern": "aw.data.qsseda.com",
      "custom_domain": true
    },
    {
      "pattern": "awd.qsseda.studio/*",
      "zone_name": "qsseda.studio"
    },
    {
      "pattern": "awd.qsseda.studio",
      "custom_domain": true
    },
    {
      "pattern": "aw.data.qsseda.studio/*",
      "zone_name": "qsseda.studio"
    },
    {
      "pattern": "aw.data.qsseda.studio",
      "custom_domain": true
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  }
}
