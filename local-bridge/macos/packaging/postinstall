#!/bin/sh
set -eu

# The installer is privileged, but the Bridge runs only in the logged-in
# user's GUI domain. The agent starts on future logins even if no GUI user
# is currently available during installation.
PLIST="/Library/LaunchAgents/com.aertex.bridge.plist"
BRIDGE="/Library/Application Support/AERTEX Bridge/AERTEX-Bridge"
/bin/chmod 644 "$PLIST"
/usr/sbin/chown root:wheel "$PLIST"
/bin/chmod 755 "$BRIDGE"

USER_NAME="$(/usr/bin/stat -f '%Su' /dev/console)"
if [ -z "$USER_NAME" ] || [ "$USER_NAME" = "root" ] || [ "$USER_NAME" = "loginwindow" ]; then
  echo "AERTEX Bridge installed; LaunchAgent starts when a user logs in."
  exit 0
fi

UID_NUM="$(/usr/bin/id -u "$USER_NAME")"
DOMAIN="gui/$UID_NUM"
LABEL="$DOMAIN/com.aertex.bridge"

# Only manage this exact launchd label; never kill arbitrary port owners.
if /bin/launchctl print "$LABEL" >/dev/null 2>&1; then
  /bin/launchctl bootout "$DOMAIN" "$PLIST" >/dev/null 2>&1 || true
fi
if ! /bin/launchctl bootstrap "$DOMAIN" "$PLIST"; then
  echo "WARNING: LaunchAgent could not start in the current GUI session." >&2
  echo "The service is installed and will start on the next login." >&2
  exit 0
fi
/bin/launchctl kickstart -k "$LABEL" >/dev/null 2>&1 || true

ATTEMPT=0
while [ "$ATTEMPT" -lt 15 ]; do
  if "$BRIDGE" --status >/dev/null 2>&1; then
    echo "AERTEX Bridge started successfully in $DOMAIN."
    exit 0
  fi
  ATTEMPT=$((ATTEMPT + 1))
  /bin/sleep 1
done
echo "WARNING: Bridge installed but did not pass its health check." >&2
echo "Open AERTEX Bridge.app for diagnostics; ~/Library/Logs/AERTEX Bridge/bridge.log." >&2
echo "Sign out and back in if this GUI session blocked launchd registration." >&2
exit 0
